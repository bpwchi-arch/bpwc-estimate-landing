# ─────────────────────────────────────────────────────────────
# Blue Pacific Window Cleaning — Server Environment Variables
# Copy this to .env and fill in your values
# In production (Idealane/Render/Railway): set in the dashboard
# ─────────────────────────────────────────────────────────────


# ── Cloudflare R2 (Photo Storage) ────────────────────────────
# Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=blue-pacific-photos
# Optional: public bucket URL or custom domain
# R2_PUBLIC_URL=https://photos.bluepacificwindowcleaning.com


# ── Slack Notifications ───────────────────────────────────────
# api.slack.com/apps > Create App > Incoming Webhooks > #new-estimates
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK


# ── Email ─────────────────────────────────────────────────────


# Option A: Gmail App Password (easiest)
# Enable at: myaccount.google.com/apppasswords
GMAIL_USER=sales@bpwchi.com
GMAIL_PASS=your_gmail_app_password


# Option B: Generic SMTP (SendGrid, Postmark, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM=sales@bpwchi.com


# Where internal team notifications go
TEAM_EMAIL=sales@bpwchi.com

# ── Lead notification routing (added 2026-08-26) ──────────────
# Which channels actually reach a HUMAN. Zapier is a router, not a
# destination: its Catch Hook returns 200 on receipt, which proves
# nothing about anyone reading the lead. See server/index.ts.
#
# TEAM_EMAIL has NO fallback. If unset, team email is skipped honestly
# and the owner-SMS backstop takes over.
TEAM_EMAIL=sales@bpwchi.com
OWNER_ALERT_PHONE=+18082072939
#
# Catch hook for the "Post new estimate leads to Slack #new-estimates"
# zap (id 377898169). Posts each lead into #new-estimates using Zapier's
# own authenticated Slack connection, so no Slack secret is needed here.
ZAPIER_SUBMIT_WEBHOOK=https://hooks.zapier.com/hooks/catch/14536948/4hyg39r/
